{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Food technology portfolio JSON data",
  "description": "Normalized JSON representation of the Food worksheet in the mirrored technology product portfolio.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "description": "Version of this JSON data contract."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workbook",
        "sheet",
        "sha256"
      ],
      "properties": {
        "workbook": {
          "const": "res/var/data/technology-product-portfolio.ods"
        },
        "sheet": {
          "const": "Food"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/foodRecord"
      }
    }
  },
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "trlRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "maximum"
      ],
      "properties": {
        "minimum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "maximum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        }
      }
    },
    "foodRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRow",
        "curationStatus",
        "name",
        "producer",
        "designer",
        "purpose",
        "description",
        "category",
        "subCategories",
        "valueChainStages",
        "sourceLinkText",
        "urls",
        "manufacturingProcesses",
        "priceUsd",
        "tariffCode",
        "hardwareLicense",
        "oshwaUid",
        "technologyReadinessLevel",
        "ceCertificate"
      ],
      "properties": {
        "sourceRow": {
          "type": "integer",
          "minimum": 4,
          "description": "One-based source row retained for traceability.",
          "x-transform": "source-row-number"
        },
        "curationStatus": {
          "$ref": "#/$defs/nullableString",
          "x-source-column": "Column 1",
          "x-transform": "nullable-string"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "x-source-column": "Project/Product Name",
          "x-transform": "required-string"
        },
        "producer": {
          "$ref": "#/$defs/nullableString",
          "x-source-column": "Producer / Maker",
          "x-transform": "nullable-string"
        },
        "designer": {
          "$ref": "#/$defs/nullableString",
          "x-source-column": "Designer",
          "x-transform": "nullable-string"
        },
        "purpose": {
          "$ref": "#/$defs/nullableString",
          "x-source-column": "Purpose (1 sentence)",
          "x-transform": "nullable-string"
        },
        "description": {
          "$ref": "#/$defs/nullableString",
          "x-source-column": "Description (can be longer)",
          "x-transform": "nullable-string"
        },
        "category": {
          "const": "Food",
          "x-source-column": "Category",
          "x-transform": "required-string"
        },
        "subCategories": {
          "$ref": "#/$defs/stringList",
          "x-source-column": "Sub-Category",
          "x-transform": "csv-string-list"
        },
        "valueChainStages": {
          "$ref": "#/$defs/stringList",
          "x-source-column": "Value Chain Stage",
          "x-transform": "csv-string-list"
        },
        "sourceLinkText": {
          "$ref": "#/$defs/nullableString",
          "x-source-column": "URL",
          "x-transform": "nullable-string"
        },
        "urls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "uniqueItems": true,
          "x-source-column": "URL",
          "x-transform": "http-url-and-doi-list"
        },
        "manufacturingProcesses": {
          "$ref": "#/$defs/stringList",
          "x-source-column": "Manufacturing Processes",
          "x-transform": "csv-string-list"
        },
        "priceUsd": {
          "$ref": "#/$defs/nullableString",
          "description": "Source price text is preserved because values include qualifiers and abbreviations.",
          "x-source-column": "Price (USD)",
          "x-transform": "nullable-string"
        },
        "tariffCode": {
          "$ref": "#/$defs/nullableString",
          "x-source-column": "Tariff Code",
          "x-transform": "nullable-string"
        },
        "hardwareLicense": {
          "$ref": "#/$defs/nullableString",
          "x-source-column": "Hardware License",
          "x-transform": "nullable-string"
        },
        "oshwaUid": {
          "$ref": "#/$defs/nullableString",
          "x-source-column": "OSHWA UID",
          "x-transform": "nullable-string"
        },
        "technologyReadinessLevel": {
          "description": "An integer TRL, an inclusive minimum/maximum range, or null.",
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9
            },
            {
              "$ref": "#/$defs/trlRange"
            },
            {
              "type": "null"
            }
          ],
          "x-source-column": "TRL",
          "x-transform": "integer-or-slash-range-or-na"
        },
        "ceCertificate": {
          "$ref": "#/$defs/nullableString",
          "x-source-column": "CE Certificate",
          "x-transform": "nullable-string"
        }
      }
    }
  },
  "x-conversion": {
    "input": "res/var/data/technology-product-portfolio.ods",
    "sheet": "Food",
    "output": "res/var/data/food.json",
    "serialization": {
      "format": "json",
      "jsonIndent": 2
    },
    "rows": {
      "licenseReference": 1,
      "header": 2,
      "dataStart": 4
    },
    "skipRowWhenColumnIsBlank": "Project/Product Name",
    "cellText": {
      "paragraphSeparator": "\n",
      "trimOuterWhitespace": true
    },
    "transforms": {
      "source-row-number": {
        "result": "one-based ODS row number"
      },
      "required-string": {
        "result": "trimmed nonempty string"
      },
      "nullable-string": {
        "result": "trimmed string or null"
      },
      "csv-string-list": {
        "result": "ordered unique RFC 4180 string list"
      },
      "http-url-and-doi-list": {
        "result": "ordered unique URL list"
      },
      "integer-or-slash-range-or-na": {
        "result": "TRL integer, inclusive range, or null"
      }
    }
  }
}
